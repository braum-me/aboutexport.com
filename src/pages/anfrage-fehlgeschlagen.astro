---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResultPage from '../components/ResultPage.astro';
import { site } from '../config/site';
---

<BaseLayout title="Anfrage nicht gesendet" path="/anfrage-fehlgeschlagen/" noindex>
  <ResultPage eyebrow="Nicht gesendet" title="Ihre Anfrage konnte nicht übermittelt werden.">
    <p>
      Bitte prüfen Sie Ihre Eingaben und versuchen Sie es erneut – oder schreiben Sie uns direkt an
      <a href={`mailto:${site.contactEmail}`} class="font-medium text-brand-700 underline">{site.contactEmail}</a>.
    </p>
  </ResultPage>
</BaseLayout>
