---
/**
 * Blog-Artikel unter den ursprünglichen WordPress-Permalinks: /<slug>/
 */
import { render } from 'astro:content';
import { ArrowLeft, ArrowRight, CalendarClock, Info } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/blog/PostCard.astro';
import Button from '../components/ui/Button.astro';
import { blogCategories } from '../config/blog';
import { site } from '../config/site';
import { formatDate, getPosts, postUrl, readingTime, type Post } from '../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

interface Props {
  post: Post;
  all: Post[];
}

const { post, all } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const category = blogCategories[data.category];
const url = new URL(postUrl(post), site.url).toString();
const minutes = readingTime(post.body ?? '');
const modified = data.updatedDate && data.updatedDate.getTime() !== data.pubDate.getTime() ? data.updatedDate : undefined;

// Verwandte Beiträge: gleiche Kategorie zuerst, dann übrige (neueste zuerst)
const related = all
  .filter((p) => p.id !== post.id)
  .sort((a, b) => Number(b.data.category === data.category) - Number(a.data.category === data.category))
  .slice(0, 2);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    image: [new URL(data.image.og, site.url).toString(), new URL(data.image.src, site.url).toString()],
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    inLanguage: 'de-DE',
    articleSection: category.label,
    author: { '@type': 'Organization', name: data.author, url: site.url },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      url: site.url,
      logo: { '@type': 'ImageObject', url: `${site.url}/images/branding/aboutexport-icon.png` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: category.label, item: `${site.url}/category/${data.category}/` },
      { '@type': 'ListItem', position: 4, name: data.title, item: url },
    ],
  },
];
---

<BaseLayout
  title={data.title}
  rawTitle={data.seoTitle}
  description={data.description}
  path={postUrl(post)}
  jsonLd={jsonLd}
  ogImage={data.image.og}
  ogImageAlt={data.image.alt}
  article={{ published: data.pubDate, modified: data.updatedDate, section: category.label }}
>
  <article data-article={post.id}>
    <header class="relative overflow-hidden border-b border-slate-200 bg-slate-50">
      <div class="bg-grid mask-fade-b absolute inset-0 opacity-70" aria-hidden="true"></div>
      <div class="container-page relative pt-12 pb-14 sm:pt-20 sm:pb-20">
        <nav aria-label="Brotkrumen" class="font-mono text-[11px] tracking-[0.12em] text-slate-500 uppercase">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="transition-colors hover:text-ink-900">Startseite</a></li>
            <li aria-hidden="true" class="text-slate-300">/</li>
            <li><a href="/blog/" class="transition-colors hover:text-ink-900">Blog</a></li>
            <li aria-hidden="true" class="text-slate-300">/</li>
            <li>
              <a href={`/category/${data.category}/`} class="text-brand-700 transition-colors hover:text-ink-900">{category.label}</a>
            </li>
          </ol>
        </nav>

        <h1 class="display-md mt-6 max-w-4xl lg:text-[3.25rem]">{data.title}</h1>
        <p class="lead mt-6 max-w-3xl">{data.excerpt}</p>

        <dl class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[11px] text-slate-500">
          <div class="flex items-center gap-2">
            <dt class="sr-only">Autor</dt>
            <span class="size-1.5 rounded-full bg-brand-600" aria-hidden="true"></span>
            <dd>{data.author}</dd>
          </div>
          <div>
            <dt class="sr-only">Veröffentlicht</dt>
            <dd><time datetime={data.pubDate.toISOString()} data-pubdate>{formatDate(data.pubDate)}</time></dd>
          </div>
          <div>
            <dt class="sr-only">Lesezeit</dt>
            <dd>{minutes} Min. Lesezeit</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="bg-white">
      <div class="container-page">
        <figure class="pt-10 sm:pt-14">
          <div class="relative aspect-[16/9] overflow-hidden rounded-2xl bg-ink-900 shadow-float lg:aspect-[16/8]">
            <img
              src={data.image.src}
              alt={data.image.alt}
              width={data.image.width}
              height={data.image.height}
              class="absolute inset-0 size-full object-cover"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </figure>

        <div class="grid gap-12 py-12 sm:py-16 lg:grid-cols-12">
          <div class="min-w-0 lg:col-span-8 xl:col-span-7 xl:col-start-2">
            {
              data.kind === 'regulatory' ? (
                <aside
                  class="flex gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950"
                  data-context-notice="historical"
                >
                  <CalendarClock size={18} class="mt-0.5 shrink-0" aria-hidden="true" />
                  <div>
                    <p class="font-semibold">Historische Regulierungsmeldung · Stand {formatDate(data.legacy?.publishedDate ?? data.pubDate)}</p>
                    <p class="mt-1 leading-relaxed">
                      Dieser Beitrag beschreibt die Rechtslage zum Zeitpunkt der Veröffentlichung. Regelungen, Fristen und
                      Listen können sich seitdem geändert haben. Der Beitrag ist keine Rechtsberatung – maßgeblich sind die
                      aktuellen Veröffentlichungen der zuständigen Behörden.
                    </p>
                  </div>
                </aside>
              ) : (
                <aside
                  class="flex gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700"
                  data-context-notice="archive"
                >
                  <Info size={18} class="mt-0.5 shrink-0" aria-hidden="true" />
                  <div>
                    <p class="font-semibold text-ink-900">Archivbeitrag · Planungsstand {formatDate(data.updatedDate ?? data.pubDate)}</p>
                    <p class="mt-1 leading-relaxed">
                      Angaben zu Zeitplan, Preisen und Konditionen können überholt sein. Aktuell gilt: {site.launch}. Den
                      aktuellen Stand finden Sie in den{' '}
                      <a href="/#preise" class="font-medium text-brand-700 underline underline-offset-2">
                        Preisen
                      </a>{' '}
                      und den{' '}
                      <a href="/#faq" class="font-medium text-brand-700 underline underline-offset-2">
                        FAQ
                      </a>
                      .
                    </p>
                  </div>
                </aside>
              )
            }

            {
              data.corrections.length > 0 && (
                <aside class="mt-4 rounded-xl border border-brand-100 bg-brand-50/50 p-4 text-sm text-slate-700" data-corrections>
                  <p class="font-semibold text-ink-900">Nachträglich aktualisiert</p>
                  <ul class="mt-2 space-y-1.5">
                    {data.corrections.map((c) => (
                      <li>
                        <time datetime={c.date.toISOString()} class="font-medium text-ink-900">{formatDate(c.date)}</time>{`: ${c.summary}`}
                      </li>
                    ))}
                  </ul>
                  <p class="mt-2 text-slate-600">
                    Ursprünglich veröffentlicht am {formatDate(data.legacy?.publishedDate ?? data.pubDate)}. Der übrige Text ist unverändert.
                  </p>
                </aside>
              )
            }

            <div class="prose-article mt-10" data-article-body>
              <Content />
            </div>

            {
              modified && (
                <p class="mt-10 font-mono text-[11px] text-slate-500">
                  Zuletzt aktualisiert am <time datetime={modified.toISOString()}>{formatDate(modified)}</time>
                </p>
              )
            }

            <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-8">
              <a
                href="/blog/"
                class="group inline-flex items-center gap-2 text-sm font-medium text-ink-900 transition-colors hover:text-brand-700"
              >
                <ArrowLeft size={16} class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true" />
                Zur Übersicht
              </a>
              <a
                href={`/category/${data.category}/`}
                class="rounded-full border border-slate-200 px-3 py-1 font-mono text-[11px] text-slate-600 transition hover:border-slate-300 hover:text-ink-900"
                >{category.label}</a
              >
            </div>
          </div>

          <aside class="hidden lg:col-span-4 lg:block xl:col-span-3" aria-label="AboutExport">
            <div class="on-dark sticky top-28 rounded-2xl bg-ink-900 p-6 text-slate-400">
              <p class="eyebrow">{site.launch}</p>
              <p class="mt-3 text-lg leading-snug font-semibold tracking-tight text-white">Exportkontrolle automatisch im Blick.</p>
              <p class="mt-2 text-sm leading-relaxed">Alerts, Newsfeed und KI-Zusammenfassungen für EU, USA und China – auf Deutsch.</p>
              <Button href="/#features" variant="glass" size="sm" class="mt-5 w-full">Produkt entdecken</Button>
            </div>
          </aside>
        </div>
      </div>
    </div>

    <div class="bg-white pb-16 sm:pb-24">
      <div class="container-page">
        <aside
          class="on-dark relative isolate overflow-hidden rounded-3xl bg-ink-900 px-6 py-12 text-slate-400 sm:px-12 sm:py-14"
          data-article-cta
        >
          <div class="bg-grid-dark mask-radial absolute inset-0 -z-10" aria-hidden="true"></div>
          <div
            class="absolute -top-32 -right-20 -z-10 h-96 w-[36rem] rounded-full bg-[radial-gradient(closest-side,rgb(43_89_240/0.4),transparent)] blur-3xl"
            aria-hidden="true"
          >
          </div>
          <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
            <div class="lg:col-span-8">
              <p class="eyebrow">{site.launch}</p>
              <p class="display-md mt-4 text-white">Export-Control-Änderungen nicht mehr manuell suchen.</p>
              <p class="lead mt-5 max-w-xl">
                AboutExport überwacht Exportkontrollvorschriften für EU, USA und China und fasst relevante Änderungen auf
                Deutsch zusammen. Tragen Sie sich in die Waitlist ein, um zum Start informiert zu werden.
              </p>
            </div>
            <div class="lg:col-span-4 lg:text-right">
              <Button href="/#waitlist" size="lg">
                Early Access sichern
                <ArrowRight size={17} class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
              </Button>
            </div>
          </div>
        </aside>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="border-t border-slate-200 bg-slate-50 py-20 sm:py-24" aria-labelledby="related-title">
          <div class="container-page">
            <div class="flex items-end justify-between gap-4">
              <div>
                <p class="eyebrow">Weiterlesen</p>
                <h2 id="related-title" class="display-md mt-4">Weitere Beiträge</h2>
              </div>
              <a href="/blog/" class="text-sm font-medium text-ink-900 transition-colors hover:text-brand-700">
                Alle Beiträge →
              </a>
            </div>
            <div class="mt-10 grid gap-4 md:grid-cols-2">
              {related.map((p) => (
                <div class="flex">
                  <PostCard post={p} />
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
