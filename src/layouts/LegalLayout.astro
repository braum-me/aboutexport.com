---
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string;
  path: string;
  description: string;
  updated: string;
}
const { title, path, description, updated } = Astro.props;
---

<BaseLayout title={title} path={path} description={description}>
  <article class="container-page max-w-3xl py-16 sm:py-24">
    <header class="border-b border-slate-200 pb-8">
      <p class="eyebrow">Rechtliches</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-sm text-slate-500">Stand: {updated}</p>
    </header>
    <div class="prose-legal mt-8">
      <slot />
    </div>
  </article>
</BaseLayout>
