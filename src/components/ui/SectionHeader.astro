---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, id, align = 'center', class: className } = Astro.props;
const center = align === 'center';
---

<div class:list={['max-w-2xl', center && 'mx-auto text-center', className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
  {
    Astro.slots.has('default') && (
      <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
        <slot />
      </p>
    )
  }
</div>
