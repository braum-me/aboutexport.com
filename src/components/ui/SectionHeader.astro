---
interface Props {
  eyebrow?: string;
  /** Kapitelnummer, z. B. "05" – Leitsystem über die Seite */
  index?: string;
  title: string;
  id?: string;
  align?: 'left' | 'center';
  size?: 'md' | 'lg';
  class?: string;
}
const { eyebrow, index, title, id, align = 'left', size = 'md', class: className } = Astro.props;
const center = align === 'center';
---

<div class:list={['max-w-2xl', center && 'mx-auto text-center', className]}>
  {
    eyebrow && (
      <p class="eyebrow">
        {index && <span class="eyebrow-index">{index} /</span>}
        {eyebrow}
      </p>
    )
  }
  <h2 id={id} class:list={['mt-4', size === 'lg' ? 'display-lg' : 'display-md']}>{title}</h2>
  {
    Astro.slots.has('default') && (
      <p class="lead mt-5">
        <slot />
      </p>
    )
  }
</div>
