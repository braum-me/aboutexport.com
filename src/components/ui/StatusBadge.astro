---
export type Status = 'launch' | 'planned' | 'future';
interface Props {
  status: Status;
  tone?: 'light' | 'dark';
  class?: string;
}
const { status, tone = 'light', class: className } = Astro.props;
const map: Record<Status, { label: string; light: string; dark: string; dot: string }> = {
  launch: {
    label: 'Zum Launch',
    light: 'bg-emerald-50 text-emerald-800 ring-emerald-600/20',
    dark: 'bg-emerald-400/10 text-emerald-300 ring-emerald-400/25',
    dot: 'bg-emerald-500',
  },
  planned: {
    label: 'Nach Launch geplant',
    light: 'bg-amber-50 text-amber-800 ring-amber-600/20',
    dark: 'bg-amber-400/10 text-amber-300 ring-amber-400/25',
    dot: 'bg-amber-500',
  },
  future: {
    label: 'In Evaluierung',
    light: 'bg-slate-100 text-slate-700 ring-slate-500/20',
    dark: 'bg-white/5 text-slate-300 ring-white/15',
    dot: 'bg-slate-400',
  },
};
const s = map[status];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-[11px] font-medium tracking-wide whitespace-nowrap ring-1 ring-inset',
    tone === 'dark' ? s.dark : s.light,
    className,
  ]}
>
  <span class:list={['size-1.5 rounded-full', s.dot]} aria-hidden="true"></span>
  {s.label}
</span>
