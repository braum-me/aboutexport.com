---
export type Status = 'launch' | 'planned' | 'future';
interface Props {
  status: Status;
  class?: string;
}
const { status, class: className } = Astro.props;
const map: Record<Status, { label: string; cls: string; dot: string }> = {
  launch: { label: 'Zum Launch', cls: 'bg-emerald-50 text-emerald-800 ring-emerald-600/20', dot: 'bg-emerald-500' },
  planned: { label: 'Nach Launch geplant', cls: 'bg-amber-50 text-amber-800 ring-amber-600/20', dot: 'bg-amber-500' },
  future: { label: 'In Evaluierung', cls: 'bg-slate-100 text-slate-700 ring-slate-500/20', dot: 'bg-slate-400' },
};
const s = map[status];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset',
    s.cls,
    className,
  ]}
>
  <span class:list={['size-1.5 rounded-full', s.dot]} aria-hidden="true"></span>
  {s.label}
</span>
