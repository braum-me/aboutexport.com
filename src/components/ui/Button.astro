---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost' | 'inverted' | 'glass';
type Size = 'sm' | 'md' | 'lg';

type Props = {
  href?: string;
  variant?: Variant;
  size?: Size;
  class?: string;
  type?: 'button' | 'submit';
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type'>;

const { href, variant = 'primary', size = 'md', class: className, type = 'button', ...rest } = Astro.props;

const base =
  'group relative inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[10px] font-medium tracking-[-0.01em] transition duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 active:translate-y-px disabled:cursor-not-allowed disabled:opacity-60';
const variants: Record<Variant, string> = {
  primary:
    'bg-brand-600 text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.18),0_0_0_1px_rgb(30_64_175/0.9),0_1px_2px_rgb(15_23_42/0.25),0_8px_24px_-8px_rgb(43_89_240/0.6)] hover:bg-brand-500 hover:shadow-[inset_0_1px_0_rgb(255_255_255/0.2),0_0_0_1px_rgb(30_64_175/0.9),0_1px_2px_rgb(15_23_42/0.25),0_10px_30px_-8px_rgb(66_113_255/0.75)] focus-visible:outline-brand-500',
  secondary:
    'border border-slate-300/90 bg-white text-ink-900 shadow-card hover:border-slate-400 hover:bg-slate-50 focus-visible:outline-brand-600',
  ghost: 'text-ink-900 hover:bg-slate-100',
  inverted: 'bg-white text-ink-900 hover:bg-brand-50 focus-visible:outline-white',
  glass:
    'border border-white/12 bg-white/[0.04] text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.06)] backdrop-blur hover:border-white/25 hover:bg-white/[0.08] focus-visible:outline-white',
};
const sizes: Record<Size, string> = {
  sm: 'h-9 px-3.5 text-sm',
  md: 'h-11 px-5 text-[15px]',
  lg: 'h-12 px-6 text-[15px]',
};
const classes = [base, variants[variant], sizes[size], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
