---
/**
 * Wiederverwendbarer Screenshot-Rahmen.
 * - Mit `src` (Pfad unter /public) wird das Bild gezeigt – sofern die Datei beim Build existiert.
 * - Ohne Bild wird der Slot (Konzept-Mockup) bzw. ein neutraler Platzhalter gerendert.
 * Das feste Seitenverhältnis verhindert Layout Shifts, auch wenn Bilder fehlen.
 * Echte Screenshots lassen sich so austauschen, ohne das Layout anzufassen (siehe README).
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { ImageOff } from '@lucide/astro';

interface Props {
  src?: string;
  alt: string;
  width?: number;
  height?: number;
  /** Tailwind-Klasse für das Seitenverhältnis, z. B. "aspect-[16/10]" */
  aspect?: string;
  /** Fensterleiste anzeigen */
  chrome?: boolean;
  /** Titel in der Fensterleiste */
  windowTitle?: string;
  /** Hintergrund, auf dem der Rahmen steht – steuert Kontrast von Rahmen & Hinweis */
  tone?: 'light' | 'dark';
  /** Ausrichtung des Konzept-Hinweises */
  captionAlign?: 'left' | 'center' | 'right';
  priority?: boolean;
  class?: string;
  frameClass?: string;
}

const {
  src,
  alt,
  width = 1600,
  height = 1000,
  aspect = 'aspect-[16/10]',
  chrome = true,
  windowTitle = 'AboutExport',
  tone = 'light',
  captionAlign = 'center',
  priority = false,
  class: className,
  frameClass,
} = Astro.props;

const hasImage = !!src && src.startsWith('/') && existsSync(join(process.cwd(), 'public', src));
const isPlaceholder = !hasImage;
const dark = tone === 'dark';
---

<figure class:list={['relative', className]} data-screenshot={isPlaceholder ? 'placeholder' : 'image'}>
  <div
    class:list={[
      'overflow-hidden rounded-xl bg-white',
      dark
        ? 'shadow-glow ring-1 ring-white/10'
        : 'shadow-float ring-1 ring-slate-900/[0.04]',
      frameClass,
    ]}
  >
    {
      chrome && (
        <div class="flex h-9 items-center gap-3 border-b border-slate-200/80 bg-slate-50/90 px-3.5" aria-hidden="true">
          <span class="flex gap-1.5">
            <span class="size-2.5 rounded-full bg-slate-300/90" />
            <span class="size-2.5 rounded-full bg-slate-300/90" />
            <span class="size-2.5 rounded-full bg-slate-300/90" />
          </span>
          <span class="mx-auto flex h-5 items-center gap-1.5 rounded-md bg-white px-3 font-mono text-[10px] text-slate-500 ring-1 ring-slate-200">
            <span class="size-1.5 rounded-full bg-emerald-500" />
            {windowTitle}
          </span>
          <span class="w-[42px]" />
        </div>
      )
    }
    <div class:list={['relative w-full', aspect]}>
      {
        hasImage ? (
          <img
            src={src}
            alt={alt}
            width={width}
            height={height}
            class="absolute inset-0 size-full object-cover object-top"
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding="async"
          />
        ) : Astro.slots.has('default') ? (
          <div class="absolute inset-0" role="img" aria-label={`${alt} (Konzeptdarstellung)`}>
            <div class="size-full" aria-hidden="true">
              <slot />
            </div>
          </div>
        ) : (
          <div
            class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-slate-50 text-slate-500"
            role="img"
            aria-label={`${alt} (Platzhalter)`}
          >
            <ImageOff size={28} aria-hidden="true" />
            <span class="text-sm">Screenshot folgt</span>
          </div>
        )
      }
    </div>
  </div>
  {
    isPlaceholder && (
      <figcaption
        class:list={[
          'mt-3 flex items-center gap-1.5 font-mono text-[10.5px] tracking-wide',
          dark ? 'text-slate-400' : 'text-slate-500',
          captionAlign === 'left' && 'justify-start',
          captionAlign === 'center' && 'justify-center',
          captionAlign === 'right' && 'justify-end',
        ]}
      >
        <span class="size-1.5 rounded-full bg-amber-400" aria-hidden="true" />
        Konzeptdarstellung – kein Screenshot des finalen Produkts
      </figcaption>
    )
  }
</figure>
