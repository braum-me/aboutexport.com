---
import PostCard from './PostCard.astro';
import { blogCategories, type BlogCategory } from '../../config/blog';
import type { Post } from '../../lib/blog';

interface Props {
  posts: Post[];
  title: string;
  description: string;
  active?: BlogCategory;
}
const { posts, title, description, active } = Astro.props;
const [first, ...rest] = posts;
const filters = [
  { href: '/blog/', label: 'Alle Beiträge', key: undefined },
  ...Object.entries(blogCategories).map(([key, c]) => ({ href: `/category/${key}/`, label: c.label, key })),
];
---

<section class="relative overflow-hidden border-b border-slate-200 bg-slate-50">
  <div class="bg-grid mask-fade-b absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div class="container-page relative pt-14 sm:pt-20">
    <nav aria-label="Brotkrumen" class="font-mono text-[11px] tracking-[0.12em] text-slate-500 uppercase">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="transition-colors hover:text-ink-900">Startseite</a></li>
        <li aria-hidden="true" class="text-slate-300">/</li>
        {
          active ? (
            <>
              <li><a href="/blog/" class="transition-colors hover:text-ink-900">Blog</a></li>
              <li aria-hidden="true" class="text-slate-300">/</li>
              <li aria-current="page" class="text-brand-700">{blogCategories[active].label}</li>
            </>
          ) : (
            <li aria-current="page" class="text-brand-700">Blog</li>
          )
        }
      </ol>
    </nav>
    <div class="mt-6 grid gap-6 lg:grid-cols-12 lg:items-end">
      <h1 class="display-lg lg:col-span-7">{title}</h1>
      <p class="lead lg:col-span-5 lg:pb-2">{description}</p>
    </div>
    <nav aria-label="Kategorien" class="mt-12 -mb-px">
      <ul class="flex gap-1 overflow-x-auto">
        {
          filters.map((f) => (
            <li class="shrink-0">
              <a
                href={f.href}
                aria-current={f.key === active ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center border-b-2 px-3 py-3 text-sm font-medium transition-colors',
                  f.key === active ? 'border-brand-600 text-ink-900' : 'border-transparent text-slate-500 hover:text-ink-900',
                ]}
              >
                {f.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>

<section class="bg-white py-14 sm:py-20" aria-label="Beiträge">
  <div class="container-page">
    {
      first ? (
        <>
          <PostCard post={first} featured headingLevel="h2" />
          {rest.length > 0 && (
            <div class="mt-4 grid gap-4 md:grid-cols-2">
              {rest.map((p) => (
                <div class="flex">
                  <PostCard post={p} headingLevel="h2" />
                </div>
              ))}
            </div>
          )}
        </>
      ) : (
        <p class="text-slate-600">In dieser Kategorie gibt es noch keine Beiträge.</p>
      )
    }
  </div>
</section>
