---
/** Gemeinsame Ansicht für /blog/ und /category/<slug>/ */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import ArticleCta from './ArticleCta.astro';
import { categories, type CategoryId } from '../../config/blog';
import { getPosts } from '../../lib/blog';

interface Props {
  category?: CategoryId;
}
const { category } = Astro.props;
const all = await getPosts();
const posts = category ? all.filter((p) => p.data.category === category) : all;
const [featured, ...rest] = posts;
const cat = category ? categories[category] : undefined;
const title = cat ? cat.label : 'Journal';
const path = cat ? `/category/${cat.slug}/` : '/blog/';
const description = cat
  ? `${cat.label}: ${cat.description}`
  : 'Das AboutExport Journal: Einordnungen zu Exportkontrolle, Sanktionen und regulatorischen Änderungen – und Neuigkeiten zum Launch.';
const tabs = [
  { href: '/blog/', label: 'Alle Beiträge', active: !category, count: all.length },
  ...Object.values(categories).map((c) => ({
    href: `/category/${c.slug}/`,
    label: c.label,
    active: category === c.slug,
    count: all.filter((p) => p.data.category === c.slug).length,
  })),
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': cat ? 'CollectionPage' : 'Blog',
    name: `${title} | AboutExport`,
    url: new URL(path, 'https://aboutexport.com').toString(),
    inLanguage: 'de-DE',
  },
];
---

<BaseLayout title={cat ? `${cat.label} – Journal` : 'Journal – Export Compliance Blog'} description={description} path={path} jsonLd={jsonLd}>
  <section class="relative overflow-hidden border-b border-slate-200 bg-slate-50">
    <div class="bg-grid mask-fade-b absolute inset-0 opacity-70" aria-hidden="true"></div>
    <div class="container-page relative pt-16 pb-12 sm:pt-24">
      <p class="eyebrow">
        {cat ? <a href="/blog/" class="hover:text-ink-900">Journal</a> : 'AboutExport'}
        <span class="eyebrow-index">/</span>
        {cat ? cat.label : 'Journal'}
      </p>
      <div class="mt-5 grid gap-6 lg:grid-cols-12 lg:items-end">
        <h1 class="display-lg lg:col-span-7">
          {cat ? cat.label : <>Journal für<br />Export Compliance.</>}
        </h1>
        <p class="lead lg:col-span-5 lg:pb-2">
          {cat ? cat.description : 'Einordnungen zu Exportkontrolle, Sanktionen und regulatorischen Änderungen – und Neuigkeiten rund um den Launch von AboutExport.'}
        </p>
      </div>
      <nav aria-label="Kategorien" class="mt-12 -mb-px flex gap-1 overflow-x-auto">
        {
          tabs.map((t) => (
            <a
              href={t.href}
              class:list={[
                'flex shrink-0 items-center gap-2 rounded-t-lg border-b-2 px-3 py-2.5 text-sm font-medium transition-colors',
                t.active ? 'border-brand-600 text-ink-900' : 'border-transparent text-slate-500 hover:text-ink-900',
              ]}
              aria-current={t.active ? 'page' : undefined}
            >
              {t.label}
              <span class="rounded-full bg-white px-1.5 font-mono text-[10px] text-slate-500 ring-1 ring-slate-200">{t.count}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20" aria-label="Beiträge">
    <div class="container-page">
      {
        featured ? (
          <>
            <PostCard post={featured} variant="featured" headingLevel="h2" eager />
            {rest.length > 0 && (
              <div class="mt-10">
                {rest.map((p) => (
                  <PostCard post={p} variant="row" headingLevel="h2" />
                ))}
              </div>
            )}
          </>
        ) : (
          <p class="text-slate-500">In dieser Kategorie gibt es noch keine Beiträge.</p>
        )
      }
    </div>
  </section>

  <ArticleCta />
</BaseLayout>
