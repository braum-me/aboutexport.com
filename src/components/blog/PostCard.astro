---
import { ArrowUpRight } from '@lucide/astro';
import { blogCategories } from '../../config/blog';
import { formatDate, postUrl, readingTime, type Post } from '../../lib/blog';

interface Props {
  post: Post;
  /** Großformat für den neuesten Beitrag */
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
  /** Bild ist oberhalb des Falzes (LCP): sofort und priorisiert laden */
  priority?: boolean;
}
const { post, featured = false, headingLevel = 'h3', priority = false } = Astro.props;
const { data } = post;
const Heading = headingLevel;
const cat = blogCategories[data.category];
const minutes = readingTime(post.body ?? '');
---

<article
  class:list={[
    'group relative flex w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card transition duration-300 hover:-translate-y-0.5 hover:shadow-elevated',
    featured && 'rounded-3xl lg:grid lg:grid-cols-12 lg:hover:translate-y-0',
  ]}
  data-post-card
>
  <div
    class:list={[
      'relative overflow-hidden bg-ink-900',
      featured ? 'aspect-[16/9] lg:col-span-7 lg:aspect-auto lg:min-h-[26rem]' : 'aspect-[16/9]',
    ]}
  >
    <img
      src={data.image.src}
      alt=""
      width={data.image.width}
      height={data.image.height}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      class="absolute inset-0 size-full object-cover transition duration-700 ease-out group-hover:scale-[1.03]"
    />
    {
      featured && (
        <span class="absolute top-4 left-4 rounded-full bg-white/90 px-2.5 py-1 font-mono text-[10.5px] font-medium tracking-wider text-ink-900 uppercase backdrop-blur">
          Neuester Beitrag
        </span>
      )
    }
  </div>
  <div class:list={['flex flex-1 flex-col p-6', featured && 'sm:p-10 lg:col-span-5']}>
    <p
      class:list={[
        'font-mono text-[11px] tracking-[0.12em] uppercase',
        data.kind === 'regulatory' ? 'text-amber-700' : 'text-brand-700',
      ]}
    >
      {cat.label}
    </p>
    <Heading
      class:list={[
        'mt-3 font-semibold tracking-tight text-ink-900',
        featured ? 'text-2xl leading-tight tracking-[-0.03em] sm:text-[2rem]' : 'text-lg leading-snug',
      ]}
    >
      <a href={postUrl(post)} class="after:absolute after:inset-0">{data.title}</a>
    </Heading>
    <p class:list={['mt-3 leading-relaxed text-slate-600', featured ? 'text-[15px]' : 'line-clamp-3 text-sm']}>{data.excerpt}</p>
    <div class="mt-auto flex items-center justify-between gap-4 pt-6">
      <p class="font-mono text-[11px] text-slate-500">
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time> · {minutes} Min.
      </p>
      <span
        class="flex size-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-ink-900 transition duration-300 group-hover:bg-brand-600 group-hover:text-white"
        aria-hidden="true"
      >
        <ArrowUpRight size={16} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </span>
    </div>
  </div>
</article>
