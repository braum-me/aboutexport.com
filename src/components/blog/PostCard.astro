---
import { ArrowUpRight } from '@lucide/astro';
import { categories } from '../../config/blog';
import { formatDate, postPath, readingTime, type Post } from '../../lib/blog';

interface Props {
  post: Post;
  variant?: 'featured' | 'default' | 'row';
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { post, variant = 'default', headingLevel = 'h3', eager = false } = Astro.props;
const { data } = post;
const Heading = headingLevel;
const cat = categories[data.category];
const minutes = readingTime(post.body);
const href = postPath(post);
---

{
  variant === 'featured' ? (
    <article class="group relative grid overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-card transition duration-300 hover:shadow-elevated lg:grid-cols-12">
      <div class="relative overflow-hidden bg-ink-900 lg:col-span-7">
        <img
          src={data.image}
          alt={data.imageAlt ?? ''}
          width="1200"
          height="675"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="aspect-[16/9] size-full object-cover transition duration-700 ease-out group-hover:scale-[1.03] lg:aspect-auto lg:min-h-[26rem]"
        />
        <span class="absolute top-4 left-4 rounded-full bg-white/90 px-2.5 py-1 font-mono text-[10.5px] font-medium tracking-wider text-ink-900 uppercase backdrop-blur">
          Aktuell
        </span>
      </div>
      <div class="flex flex-col p-6 sm:p-10 lg:col-span-5">
        <p class="font-mono text-[11px] tracking-[0.12em] text-brand-700 uppercase">{cat.label}</p>
        <Heading class="mt-4 text-2xl leading-tight font-semibold tracking-[-0.03em] sm:text-[2rem]">
          <a href={href} class="after:absolute after:inset-0">
            {data.title}
          </a>
        </Heading>
        <p class="mt-4 text-[15px] leading-relaxed text-slate-600">{data.excerpt}</p>
        <div class="mt-auto flex items-center justify-between gap-4 pt-8">
          <p class="font-mono text-[11px] text-slate-500">
            <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time> · {minutes} Min. Lesezeit
          </p>
          <span class="flex size-9 items-center justify-center rounded-full bg-ink-900 text-white transition duration-300 group-hover:bg-brand-600">
            <ArrowUpRight size={17} class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
          </span>
        </div>
      </div>
    </article>
  ) : variant === 'row' ? (
    <article class="group relative grid gap-5 border-t border-slate-200 py-8 sm:grid-cols-12 sm:items-center">
      <p class="font-mono text-[11px] text-slate-500 sm:col-span-2">
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
      </p>
      <div class="sm:col-span-7">
        <p class="font-mono text-[11px] tracking-[0.12em] text-brand-700 uppercase">{cat.label}</p>
        <Heading class="mt-2 text-xl leading-snug font-semibold tracking-tight transition-colors group-hover:text-brand-700">
          <a href={href} class="after:absolute after:inset-0">
            {data.title}
          </a>
        </Heading>
        <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600">{data.excerpt}</p>
      </div>
      <div class="relative overflow-hidden rounded-xl bg-ink-900 sm:col-span-3">
        <img
          src={data.image}
          alt=""
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
          class="aspect-[16/10] w-full object-cover transition duration-700 ease-out group-hover:scale-[1.04]"
        />
      </div>
    </article>
  ) : (
    <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card transition duration-300 hover:-translate-y-0.5 hover:shadow-elevated">
      <div class="relative overflow-hidden bg-ink-900">
        <img
          src={data.image}
          alt=""
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
          class="aspect-[16/9] w-full object-cover transition duration-700 ease-out group-hover:scale-[1.04]"
        />
      </div>
      <div class="flex flex-1 flex-col p-6">
        <p class="font-mono text-[11px] tracking-[0.12em] text-brand-700 uppercase">{cat.label}</p>
        <Heading class="mt-3 text-lg leading-snug font-semibold tracking-tight">
          <a href={href} class="after:absolute after:inset-0">
            {data.title}
          </a>
        </Heading>
        <p class="mt-auto pt-6 font-mono text-[11px] text-slate-500">
          <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time> · {minutes} Min.
        </p>
      </div>
    </article>
  )
}
