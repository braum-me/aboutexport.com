---
import { ArrowRight } from '@lucide/astro';
import Button from '../ui/Button.astro';
import { pricing } from '../../config/pricing';
import { site } from '../../config/site';
const d = pricing.earlyAccessDiscount;
interface Props {
  class?: string;
}
const { class: className = 'bg-white' } = Astro.props;
---

<section class:list={['pb-20 sm:pb-28', className]} aria-labelledby="article-cta-title">
  <div class="container-page">
    <div class="on-dark relative isolate overflow-hidden rounded-3xl bg-ink-900 px-6 py-12 text-slate-400 sm:px-12 sm:py-16">
      <div class="bg-grid-dark mask-radial absolute inset-0 -z-10" aria-hidden="true"></div>
      <div
        class="absolute -top-32 -right-20 -z-10 h-96 w-[36rem] rounded-full bg-[radial-gradient(closest-side,rgb(43_89_240/0.4),transparent)] blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow">{site.launch}</p>
          <h2 id="article-cta-title" class="display-md mt-4 text-white">
            Regulatorische Änderungen erkennen, bevor sie zum Problem werden.
          </h2>
          <p class="lead mt-5 max-w-xl">
            AboutExport überwacht Exportkontrollvorschriften in EU, USA und China und liefert verständliche Updates auf
            Deutsch.{d.enabled && <> Waitlist-Mitgliedern ist ein {d.percent} % {d.label} vorgesehen.</>}
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
          <Button href="/#waitlist" size="lg">
            Early Access sichern
            <ArrowRight size={17} class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
          </Button>
          <Button href="/#features" size="lg" variant="glass">Produkt entdecken</Button>
        </div>
      </div>
    </div>
  </div>
</section>
