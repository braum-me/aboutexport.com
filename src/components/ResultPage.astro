---
import { ArrowLeft } from '@lucide/astro';
import Button from './ui/Button.astro';
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
  <div class="mt-4 max-w-lg text-slate-600"><slot /></div>
  <Button href="/" variant="secondary" class="mt-8"><ArrowLeft size={18} aria-hidden="true" /> Zur Startseite</Button>
</section>
