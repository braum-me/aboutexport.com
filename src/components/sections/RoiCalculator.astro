---
import { ArrowRight, ChevronDown, Info } from '@lucide/astro';
import { pricing } from '../../config/pricing';
import { roiConfig } from '../../config/roi';
import { calculateRoi } from '../../lib/roi';
import { formatCurrency, formatPercent } from '../../lib/format';
import Button from '../ui/Button.astro';

const { defaults, limits, workingDaysPerYear } = roiConfig;
const d = pricing.earlyAccessDiscount;
const initial = calculateRoi({ ...defaults });
if (!initial.ok) throw new Error('ROI-Defaults sind ungültig');
const r = initial.result;
const regionOptions = Array.from({ length: pricing.maxRegions - pricing.minRegions + 1 }, (_, i) => pricing.minRegions + i);

// Startbreiten der Vergleichsbalken (SVG-Attribute, CSP-konform ohne Inline-Styles)
const maxCost = Math.max(r.annualManualCost, r.annualSubscriptionCost, 1);
const pct = (v: number) => `${Math.max(1.5, (v / maxCost) * 100).toFixed(2)}%`;
const sliders = {
  minutesPerDay: { max: 120 },
  hourlyRate: { max: 200 },
};
---

<section id="roi" class="relative scroll-mt-16 overflow-hidden bg-slate-50 py-24 sm:py-32" aria-labelledby="roi-title">
  <div class="bg-grid mask-fade-b absolute inset-x-0 top-0 h-96 opacity-50" aria-hidden="true"></div>
  <div class="container-page relative">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow"><span class="eyebrow-index">06 /</span> ROI-Rechner</p>
        <h2 id="roi-title" class="display-lg mt-4">Ab wann lohnt sich AboutExport?</h2>
      </div>
      <p class="lead lg:col-span-5 lg:pb-2" data-reveal>
        Vergleichen Sie Ihren heutigen Rechercheaufwand mit den Kosten eines Abonnements. Eine Schätzung – keine Garantie.
      </p>
    </div>

    <form
      class="mt-14 grid overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-[0_1px_0_rgb(15_23_42/0.04),0_30px_60px_-30px_rgb(15_23_42/0.2)] sm:mt-16 lg:grid-cols-[1fr_1.1fr]"
      data-roi
      novalidate
      data-reveal
    >
      <!-- Annahmen -->
      <div class="p-6 sm:p-10">
        <p class="font-mono text-[11px] tracking-[0.14em] text-slate-500 uppercase">Ihre Annahmen</p>

        <div class="mt-6">
          <div class="flex items-end justify-between gap-4">
            <label for="roi-minutes" class="label mb-0 max-w-[14rem]">Manuelle Recherche pro Arbeitstag</label>
            <span class="flex items-baseline gap-1.5">
              <input
                id="roi-minutes"
                name="minutesPerDay"
                type="number"
                inputmode="numeric"
                min={limits.minutesPerDay.min}
                max={limits.minutesPerDay.max}
                step="1"
                value={defaults.minutesPerDay}
                class="input h-11 w-[5.5rem] py-0 text-right font-mono text-lg font-medium tabular-nums"
                aria-describedby="roi-minutes-error"
                required
              />
              <span class="w-12 text-sm text-slate-500">Min.</span>
            </span>
          </div>
          <input
            type="range"
            min={limits.minutesPerDay.min}
            max={sliders.minutesPerDay.max}
            step={limits.minutesPerDay.step}
            value={defaults.minutesPerDay}
            class="range mt-4"
            aria-label="Minuten pro Arbeitstag (Schieberegler)"
            data-roi-sync="minutesPerDay"
          />
          <div class="mt-1 flex justify-between font-mono text-[10px] text-slate-500" aria-hidden="true">
            <span>0</span><span>60</span><span>{sliders.minutesPerDay.max}</span>
          </div>
          <p id="roi-minutes-error" class="field-error" data-roi-error="minutesPerDay" hidden></p>
        </div>

        <div class="mt-8">
          <div class="flex items-end justify-between gap-4">
            <label for="roi-rate" class="label mb-0">Interner Stundensatz</label>
            <span class="flex items-baseline gap-1.5">
              <input
                id="roi-rate"
                name="hourlyRate"
                type="number"
                inputmode="decimal"
                min={limits.hourlyRate.min}
                max={limits.hourlyRate.max}
                step="0.01"
                value={defaults.hourlyRate}
                class="input h-11 w-[5.5rem] py-0 text-right font-mono text-lg font-medium tabular-nums"
                aria-describedby="roi-rate-error"
                required
              />
              <span class="w-12 text-sm text-slate-500">€ / h</span>
            </span>
          </div>
          <input
            type="range"
            min={limits.hourlyRate.min}
            max={sliders.hourlyRate.max}
            step={limits.hourlyRate.step}
            value={defaults.hourlyRate}
            class="range mt-4"
            aria-label="Stundensatz in Euro (Schieberegler)"
            data-roi-sync="hourlyRate"
          />
          <div class="mt-1 flex justify-between font-mono text-[10px] text-slate-500" aria-hidden="true">
            <span>0 €</span><span>100 €</span><span>{sliders.hourlyRate.max} €</span>
          </div>
          <p id="roi-rate-error" class="field-error" data-roi-error="hourlyRate" hidden></p>
        </div>

        <div class="mt-8 grid gap-6 sm:grid-cols-[1.5fr_1fr]">
          <fieldset>
            <legend class="label">Überwachte Regionen</legend>
            <div class="grid grid-cols-3 gap-1 rounded-xl bg-slate-100 p-1 ring-1 ring-slate-200/70 ring-inset">
              {
                regionOptions.map((n) => (
                  <label class="cursor-pointer">
                    <input type="radio" name="regions" value={n} class="peer sr-only" checked={n === defaults.regions} />
                    <span class="flex h-10 items-center justify-center rounded-lg text-[13px] font-medium whitespace-nowrap text-slate-600 transition duration-200 peer-checked:bg-white peer-checked:text-ink-900 peer-checked:shadow-[0_1px_2px_rgb(15_23_42/0.08),0_0_0_1px_rgb(15_23_42/0.06)] peer-focus-visible:outline-2 peer-focus-visible:outline-brand-600 hover:text-ink-900">
                      {n} {n === 1 ? 'Region' : 'Regionen'}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset>
            <legend class="label">Abrechnung</legend>
            <div class="grid grid-cols-2 gap-1 rounded-xl bg-slate-100 p-1 ring-1 ring-slate-200/70 ring-inset">
              {
                [
                  ['monthly', 'Monatlich'],
                  ['annual', 'Jährlich'],
                ].map(([value, label]) => (
                  <label class="cursor-pointer">
                    <input type="radio" name="interval" value={value} class="peer sr-only" checked={value === defaults.interval} />
                    <span class="flex h-10 items-center justify-center rounded-lg text-[13px] font-medium text-slate-600 transition duration-200 peer-checked:bg-white peer-checked:text-ink-900 peer-checked:shadow-[0_1px_2px_rgb(15_23_42/0.08),0_0_0_1px_rgb(15_23_42/0.06)] peer-focus-visible:outline-2 peer-focus-visible:outline-brand-600 hover:text-ink-900">
                      {label}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        {
          d.enabled && (
            <label class="mt-7 flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-slate-300">
              <input
                type="checkbox"
                name="applyDiscount"
                class="relative h-6 w-10 shrink-0 cursor-pointer appearance-none rounded-full bg-slate-200 transition-colors duration-200 before:absolute before:top-1 before:left-1 before:size-4 before:rounded-full before:bg-white before:shadow before:transition-transform before:duration-200 checked:bg-brand-600 checked:before:translate-x-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
                checked={defaults.applyDiscount}
              />
              <span class="text-sm text-slate-700">
                {d.percent} % {d.label} einrechnen
                <span class="block text-xs text-slate-500">Nur für Waitlist-Mitglieder vorgesehen.</span>
              </span>
            </label>
          )
        }
      </div>

      <!-- Ergebnis -->
      <div
        class="flex flex-col border-t border-slate-200 bg-slate-50/70 p-6 transition-opacity duration-300 sm:p-10 lg:border-t-0 lg:border-l"
        aria-live="polite"
        data-roi-results
      >
        <div
          class="on-dark relative overflow-hidden rounded-2xl bg-ink-900 p-6 text-white transition-colors duration-300 sm:p-7"
          data-roi-highlight
        >
          <div
            class="absolute -top-20 -right-16 h-56 w-56 rounded-full bg-[radial-gradient(closest-side,rgb(66_113_255/0.45),transparent)] blur-2xl"
            aria-hidden="true"
          >
          </div>
          <div class="relative flex items-start justify-between gap-3">
            <p class="text-sm text-slate-300" data-roi-out="savingsLabel">
              {r.isSaving ? 'Mögliche Ersparnis pro Jahr' : 'Mehrkosten pro Jahr'}
            </p>
            <span
              class="shrink-0 rounded-full bg-white/10 px-2.5 py-1 font-mono text-xs font-semibold whitespace-nowrap tabular-nums ring-1 ring-white/15"
              data-roi-out="roiPercent">ROI {r.roiPercent === null ? '–' : formatPercent(r.roiPercent)}</span
            >
          </div>
          <p class="relative mt-3 text-5xl font-semibold tracking-[-0.04em] tabular-nums sm:text-6xl" data-roi-out="annualSavings">
            {formatCurrency(Math.abs(r.annualSavings))}
          </p>
          <p class="relative mt-2 text-sm text-slate-300">
            <span class="font-mono tabular-nums" data-roi-out="monthlySavings">{formatCurrency(Math.abs(r.monthlySavings))}</span>
            <span data-roi-out="monthlyLabel">{r.isSaving ? 'pro Monat' : 'Mehrkosten pro Monat'}</span>
          </p>
        </div>

        <p class="mt-4 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800" data-roi-invalid>
          Bitte korrigieren Sie die markierten Eingaben.
        </p>

        <!-- Kostenvergleich -->
        <div class="mt-8 space-y-5">
          <div>
            <div class="flex items-baseline justify-between gap-4">
              <p class="text-sm text-slate-600">Manuelle Recherche / Jahr</p>
              <p class="font-mono text-lg font-medium text-ink-900 tabular-nums" data-roi-out="annualManualCost">
                {formatCurrency(r.annualManualCost)}
              </p>
            </div>
            <svg class="mt-2 block h-3 w-full overflow-visible" aria-hidden="true">
              <rect width="100%" height="12" rx="6" class="fill-slate-200/70"></rect>
              <rect width={pct(r.annualManualCost)} height="12" rx="6" class="fill-slate-400 transition-[width] duration-500 ease-out" data-roi-bar="manual"></rect>
            </svg>
          </div>
          <div>
            <div class="flex items-baseline justify-between gap-4">
              <p class="text-sm text-slate-600">AboutExport / Jahr</p>
              <p class="font-mono text-lg font-medium text-ink-900 tabular-nums" data-roi-out="annualSubscriptionCost">
                {formatCurrency(r.annualSubscriptionCost)}
              </p>
            </div>
            <svg class="mt-2 block h-3 w-full overflow-visible" aria-hidden="true">
              <rect width="100%" height="12" rx="6" class="fill-slate-200/70"></rect>
              <rect width={pct(r.annualSubscriptionCost)} height="12" rx="6" class="fill-brand-600 transition-[width] duration-500 ease-out" data-roi-bar="subscription"></rect>
            </svg>
          </div>
        </div>

        <details class="group mt-8 rounded-xl border border-slate-200 bg-white text-sm text-slate-600">
          <summary
            class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 font-medium text-ink-900 [&::-webkit-details-marker]:hidden"
          >
            <Info size={16} class="text-slate-500" aria-hidden="true" /> Annahmen &amp; Berechnung
            <ChevronDown size={16} class="ml-auto text-slate-500 transition-transform group-open:rotate-180" aria-hidden="true" />
          </summary>
          <ul class="list-disc space-y-1.5 border-t border-slate-100 px-4 py-3 pl-8 text-xs leading-relaxed">
            <li>{workingDaysPerYear} Arbeitstage pro Jahr.</li>
            <li>Manuelle Kosten = Minuten pro Tag ÷ 60 × Stundensatz × {workingDaysPerYear}.</li>
            <li>
              Abokosten = Regionen × {formatCurrency(pricing.monthlyPricePerRegion)} × 12 (monatlich) bzw. Regionen × {
                formatCurrency(pricing.annualPricePerRegion)
              } (jährlich), optional abzüglich Early-Access-Rabatt. {pricing.taxNote}
            </li>
            <li>ROI = (Manuelle Kosten − Abokosten) ÷ Abokosten × 100.</li>
            <li>
              Es wird angenommen, dass der eingegebene Rechercheaufwand vollständig entfällt. In der Praxis bleibt Aufwand für
              Prüfung und Umsetzung bestehen – das Ergebnis ist eine Schätzung, keine zugesicherte Ersparnis.
            </li>
          </ul>
        </details>

        <div class="mt-auto pt-8">
          <Button href="#waitlist" size="lg" class="w-full">
            Early Access sichern
            <ArrowRight size={18} class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
          </Button>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  import { initRoi } from '../../scripts/roi';
  initRoi();
</script>
