---
import { steps } from '../../config/content';
---

<section class="relative isolate overflow-hidden bg-ink-900 py-20 text-slate-300 sm:py-28" aria-labelledby="how-title">
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(60%_50%_at_50%_0%,rgb(37_99_235/0.25),transparent)]"
    aria-hidden="true"
  >
  </div>
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow text-brand-300">So funktioniert's</p>
      <h2 id="how-title" class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
        In vier Schritten zum Überblick.
      </h2>
    </div>
    <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <li class="relative rounded-2xl border border-white/10 bg-white/[0.03] p-6">
            <span class="font-mono text-sm text-brand-300">0{i + 1}</span>
            <h3 class="mt-4 text-base font-semibold text-white">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
