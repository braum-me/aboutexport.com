---
import { steps } from '../../config/content';
---

<section class="relative bg-white py-24 sm:py-28" aria-labelledby="how-title">
  <div class="container-page">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow"><span class="eyebrow-index">04 /</span> So funktioniert's</p>
        <h2 id="how-title" class="display-md mt-4">In vier Schritten zum Überblick.</h2>
      </div>
      <p class="lead lg:col-span-5 lg:col-start-8" data-reveal>
        Einmal eingerichtet, läuft das Monitoring im Hintergrund. Sie entscheiden, was Sie wann erreicht.
      </p>
    </div>

    <ol class="relative mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <!-- Verbindungslinie -->
      <span
        class="absolute top-[15px] right-[12%] left-4 hidden h-px bg-gradient-to-r from-brand-600 via-brand-300 to-slate-200 lg:block"
        aria-hidden="true"></span>
      {
        steps.map((s, i) => (
          <li class="relative" data-reveal data-reveal-delay={i * 90}>
            <span
              class:list={[
                'relative flex size-8 items-center justify-center rounded-full font-mono text-[11px] font-semibold ring-4 ring-white',
                i === 0 ? 'bg-brand-600 text-white' : 'bg-white text-ink-900 shadow-[inset_0_0_0_1px_var(--color-slate-300)]',
              ]}
            >
              0{i + 1}
            </span>
            <h3 class="mt-6 text-[17px] font-semibold tracking-tight">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
