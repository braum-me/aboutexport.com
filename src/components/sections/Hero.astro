---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { ArrowRight } from '@lucide/astro';
import Button from '../ui/Button.astro';
import Screenshot from '../ui/Screenshot.astro';
import DashboardMock from '../mocks/DashboardMock.astro';
import RegionChip from '../mocks/kit/RegionChip.astro';
import SeverityChip from '../mocks/kit/SeverityChip.astro';
import { pricing } from '../../config/pricing';

const d = pricing.earlyAccessDiscount;
const heroImage = '/images/product/dashboard.webp';
// Schwebende Konzept-Karten nur zusammen mit dem Konzept-Mockup zeigen – nicht neben einem echten Screenshot.
const isConcept = !existsSync(join(process.cwd(), 'public', heroImage));
---

<section class="on-dark relative isolate overflow-hidden bg-ink-900 text-slate-400" aria-labelledby="hero-title">
  <!-- Hintergrund: Raster, Lichtkegel, Noise -->
  <div class="bg-grid-dark mask-radial absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class="absolute -top-48 left-[10%] -z-10 h-[38rem] w-[52rem] rounded-full bg-[radial-gradient(closest-side,rgb(66_113_255/0.28),transparent)] blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-1/3 -right-40 -z-10 h-[34rem] w-[40rem] rounded-full bg-[radial-gradient(closest-side,rgb(30_64_175/0.35),transparent)] blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="bg-noise pointer-events-none absolute inset-0 -z-10 opacity-[0.035] mix-blend-overlay" aria-hidden="true"></div>

  <div class="container-page grid items-center gap-14 pt-14 pb-20 sm:pt-20 lg:grid-cols-12 lg:gap-8 lg:pt-24 lg:pb-28">
    <div class="lg:col-span-6 xl:col-span-5">
      <a
        href="#waitlist"
        class="motion-safe:animate-fade-up group inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.04] py-1 pr-3 pl-1 text-xs text-slate-300 transition hover:border-white/20 hover:bg-white/[0.07]"
      >
        <span class="rounded-full bg-brand-600 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-white uppercase"
          >Launching 2027</span
        >
        Early Access über die Waitlist
        <ArrowRight size={13} class="text-slate-400 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>

      <h1 id="hero-title" class="display-xl motion-safe:animate-fade-up mt-7 text-white lg:text-[3.75rem] xl:text-[4.1rem]">
        Exportkontrolle.<br />
        <span class="bg-gradient-to-r from-brand-300 via-brand-400 to-white bg-clip-text text-transparent"
          >Immer einen Schritt voraus.</span
        >
      </h1>

      <p class="lead motion-safe:animate-fade-up mt-7 max-w-[30rem] text-pretty">
        Internationale Vorschriften im Blick. Relevante Änderungen sofort verstehen.
        <span class="text-slate-200">Compliance-Monitoring, das für Sie mitdenkt.</span>
      </p>

      <div class="motion-safe:animate-fade-up mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href="#waitlist" size="lg">
          Early Access sichern
          <ArrowRight size={17} class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
        </Button>
        <Button href="#features" size="lg" variant="glass">Produkt entdecken</Button>
      </div>

      <dl class="mt-12 grid max-w-md grid-cols-3 gap-px overflow-hidden rounded-xl border border-white/[0.08] bg-white/[0.06] text-center">
        <div class="bg-ink-900/90 px-3 py-3">
          <dt class="font-mono text-[10px] tracking-[0.14em] text-slate-400 uppercase">Regionen</dt>
          <dd class="mt-1 text-sm font-medium text-white">EU · USA · CN</dd>
        </div>
        <div class="bg-ink-900/90 px-3 py-3">
          <dt class="font-mono text-[10px] tracking-[0.14em] text-slate-400 uppercase">Sprache</dt>
          <dd class="mt-1 text-sm font-medium text-white">Deutsch</dd>
        </div>
        <div class="bg-ink-900/90 px-3 py-3">
          <dt class="font-mono text-[10px] tracking-[0.14em] text-slate-400 uppercase">Waitlist</dt>
          <dd class="mt-1 text-sm font-medium text-white">{d.enabled ? `−${d.percent} %` : 'Early Access'}</dd>
        </div>
      </dl>
    </div>

    <!-- Produktvisualisierung: ragt auf großen Screens über den Container hinaus -->
    <div class="relative lg:col-span-6 lg:-mr-40 xl:col-span-7 xl:-mr-52">
      <Screenshot
        src={heroImage}
        alt="AboutExport Monitoring-Übersicht mit neuen Änderungen nach Region, Dringlichkeit und KI-Zusammenfassung"
        aspect="aspect-[4/5] sm:aspect-[16/11] lg:aspect-[15/11] xl:aspect-[16/10.5]"
        tone="dark"
        windowTitle="Monitoring · Übersicht"
        captionAlign="left"
        priority
      >
        <DashboardMock />
      </Screenshot>

      {
        isConcept && (
          <>
            <div
              class="shadow-float absolute -top-6 right-3 hidden w-[17rem] rounded-xl bg-white/95 p-3.5 text-[11px] ring-1 ring-slate-900/5 backdrop-blur sm:block lg:top-auto lg:right-auto lg:bottom-20 lg:-left-16"
              aria-hidden="true"
            >
              <div class="flex items-center gap-2">
                <span class="relative flex size-7 items-center justify-center rounded-lg bg-red-50 text-red-600 ring-1 ring-red-600/15">
                  <span class="font-mono text-xs font-bold">!</span>
                </span>
                <div class="min-w-0">
                  <p class="font-semibold text-ink-900">Neuer kritischer Alert</p>
                  <p class="font-mono text-[9.5px] text-slate-400">per E-Mail &amp; im Dashboard</p>
                </div>
              </div>
              <p class="mt-2.5 leading-snug text-slate-700">Aktualisierung von Anhang I der Dual-Use-Verordnung</p>
              <div class="mt-2 flex gap-1">
                <SeverityChip severity="critical" />
                <RegionChip region="EU" />
                <span class="chip bg-slate-100 text-slate-600">Dual-Use</span>
              </div>
            </div>

          </>
        )
      }
    </div>
  </div>

  <div class="hairline absolute inset-x-0 bottom-0" aria-hidden="true"></div>
</section>
