---
import { ArrowRight } from '@lucide/astro';
import PostCard from '../blog/PostCard.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { getPosts } from '../../lib/blog';

const posts = (await getPosts()).slice(0, 3);
---

{
  posts.length > 0 && (
    <section id="blog" class="scroll-mt-16 border-t border-slate-200 py-20 sm:py-28" aria-labelledby="blog-title">
      <div class="container-page">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <SectionHeader id="blog-title" eyebrow="Blog" title="News & Einordnungen." align="left">
            Produktnews und Hintergründe zu Änderungen in der Exportkontrolle.
          </SectionHeader>
          <a href="/blog/" class="inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-brand-700 hover:underline">
            Alle Beiträge <ArrowRight size={16} aria-hidden="true" />
          </a>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {posts.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </div>
    </section>
  )
}
