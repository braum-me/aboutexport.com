---
import Logo from './Logo.astro';
import { legalNav, nav, site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="on-dark relative overflow-hidden border-t border-white/[0.07] bg-ink-950 text-slate-400">
  <div class="container-page grid gap-12 pt-16 pb-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo variant="white" class="h-6" />
      <p class="mt-5 max-w-sm text-sm leading-relaxed">
        Export Control Monitoring für EU, USA und China – automatisch überwacht, KI-zusammengefasst, auf Deutsch.
      </p>
      <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 font-mono text-[11px] text-slate-300">
        <span class="size-1.5 rounded-full bg-brand-500"></span>{site.launch}
      </p>
    </div>
    <nav aria-label="Footer-Navigation" class="md:col-span-3 md:col-start-7">
      <h2 class="font-mono text-[11px] font-medium tracking-[0.14em] text-slate-400 uppercase">Produkt</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="/#waitlist" class="transition-colors hover:text-white">Waitlist</a></li>
      </ul>
    </nav>
    <div class="md:col-span-3">
      <h2 class="font-mono text-[11px] font-medium tracking-[0.14em] text-slate-400 uppercase">Kontakt &amp; Rechtliches</h2>
      <ul class="mt-5 space-y-3 text-sm">
        <li><a href={`mailto:${site.contactEmail}`} class="transition-colors hover:text-white">{site.contactEmail}</a></li>
        <li><a href="/#kontakt" class="transition-colors hover:text-white">Kontaktformular</a></li>
        {
          legalNav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-page" aria-hidden="true">
    <p
      class="bg-gradient-to-b from-white/[0.09] to-white/0 bg-clip-text text-center text-[17vw] leading-[0.8] font-semibold tracking-[-0.06em] text-transparent select-none lg:text-[13.5rem]"
    >
      AboutExport
    </p>
  </div>

  <div class="border-t border-white/[0.07]">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.owner}</p>
      <p>Keine Tracking-Cookies. Keine Drittanbieter-Skripte.</p>
    </div>
  </div>
</footer>
