---
import { ArrowRight, Menu, X } from '@lucide/astro';
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
import { nav } from '../config/site';
---

<header
  class="sticky top-0 z-50 border-b border-white/[0.07] bg-ink-900 supports-[backdrop-filter]:bg-ink-900/95 supports-[backdrop-filter]:backdrop-blur-xl"
  data-header
>
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="-m-1 flex shrink-0 items-center rounded-md p-1" aria-label="AboutExport – zur Startseite">
      <Logo variant="white" class="h-6 sm:h-[26px]" />
    </a>

    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-0.5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-md px-3 py-2 text-[13.5px] font-medium text-slate-400 transition-colors duration-200 hover:text-white"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/#kontakt"
        class="hidden rounded-md px-3 py-2 text-[13.5px] font-medium text-slate-400 transition-colors hover:text-white lg:block"
        >Kontakt</a
      >
      <div class="hidden sm:block">
        <Button href="/#waitlist" size="sm">
          Early Access sichern
          <ArrowRight size={15} class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
        </Button>
      </div>
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-lg text-white hover:bg-white/10 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menü öffnen"
        data-nav-toggle
      >
        <Menu size={22} data-icon-open aria-hidden="true" />
        <X size={22} data-icon-close class="hidden" aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile Navigation"
    class="max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-white/[0.07] bg-ink-900 md:hidden"
    hidden
    data-mobile-nav
  >
    <ul class="container-page flex flex-col py-3">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex items-center justify-between rounded-lg px-3 py-3.5 text-[17px] font-medium text-white hover:bg-white/5"
              data-mobile-link
            >
              {item.label}
              <ArrowRight size={16} class="text-slate-500" aria-hidden="true" />
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/#kontakt"
          class="flex items-center justify-between rounded-lg px-3 py-3.5 text-[17px] font-medium text-white hover:bg-white/5"
          data-mobile-link
          >Kontakt <ArrowRight size={16} class="text-slate-500" aria-hidden="true" /></a
        >
      </li>
      <li class="px-3 pt-3 pb-3">
        <Button href="/#waitlist" size="lg" class="w-full" data-mobile-link>Early Access sichern</Button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  if (toggle && panel) {
    const iconOpen = toggle.querySelector('[data-icon-open]');
    const iconClose = toggle.querySelector('[data-icon-close]');

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(Boolean(panel.hidden)));
    panel.querySelectorAll('[data-mobile-link]').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
