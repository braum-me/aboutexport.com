---
// Konzept-Mockup der Monitoring-Übersicht (Hero). Rein dekorativ, Beispieldaten.
import { Bell, FileText, LayoutGrid, Newspaper, Search, Sparkles } from '@lucide/astro';
import MarkIcon from './kit/MarkIcon.astro';
import RegionChip from './kit/RegionChip.astro';
import SeverityChip from './kit/SeverityChip.astro';
import { sampleUpdates } from './sample';

const navItems = [
  { icon: LayoutGrid, label: 'Übersicht', active: true },
  { icon: Bell, label: 'Alerts', badge: '2' },
  { icon: Newspaper, label: 'Newsfeed' },
  { icon: Sparkles, label: 'Zusammenfassungen' },
  { icon: FileText, label: 'Quellen' },
];
const regions = [
  { code: 'EU', name: 'Europäische Union' },
  { code: 'USA', name: 'Vereinigte Staaten' },
  { code: 'CN', name: 'China' },
];
// Dekorative Aktivitätsbalken (keine Kennzahlen)
const activity = [
  [3, 5, 2, 6, 4, 7, 5, 8, 4, 6, 9, 5],
  [2, 4, 6, 3, 5, 4, 7, 3, 6, 5, 4, 7],
  [1, 3, 2, 4, 2, 5, 3, 2, 4, 3, 5, 3],
];
const selected = sampleUpdates[0]!;
---

<div class="@container flex size-full bg-white text-[11px] text-slate-600 select-none">
  <!-- Sidebar -->
  <aside class="hidden w-[172px] shrink-0 flex-col border-r border-slate-200/80 bg-slate-50/80 @3xl:flex">
    <div class="flex items-center gap-2 border-b border-slate-200/80 px-3.5 py-3">
      <MarkIcon class="size-5" />
      <span class="font-semibold tracking-tight text-ink-900">AboutExport</span>
    </div>
    <nav class="flex flex-col gap-0.5 p-2">
      {
        navItems.map((n) => (
          <span
            class:list={[
              'flex items-center gap-2 rounded-md px-2 py-1.5',
              n.active ? 'bg-white font-medium text-ink-900 shadow-card ring-1 ring-slate-200/80' : 'text-slate-600',
            ]}
          >
            <n.icon size={13} stroke-width={1.75} class={n.active ? 'text-brand-600' : 'text-slate-500'} />
            {n.label}
            {n.badge && (
              <span class="ml-auto rounded bg-red-500 px-1 font-mono text-[9px] leading-4 font-semibold text-white">
                {n.badge}
              </span>
            )}
          </span>
        ))
      }
    </nav>
    <p class="mt-3 px-4 font-mono text-[9px] tracking-[0.14em] text-slate-500 uppercase">Regionen</p>
    <div class="flex flex-col gap-0.5 p-2">
      {
        regions.map((r) => (
          <span class="flex items-center gap-2 rounded-md px-2 py-1.5">
            <span class="w-6 font-mono text-[9.5px] font-semibold text-ink-900">{r.code}</span>
            <span class="truncate text-slate-500">{r.name}</span>
            <span class="ml-auto size-1.5 shrink-0 rounded-full bg-emerald-500" />
          </span>
        ))
      }
    </div>
    <div class="mt-auto border-t border-slate-200/80 p-3">
      <span class="chip bg-amber-50 text-amber-800 ring-1 ring-inset ring-amber-600/20">Beispieldaten</span>
    </div>
  </aside>

  <!-- Hauptbereich -->
  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex items-center gap-3 border-b border-slate-200/80 px-3.5 py-2.5 @lg:px-4">
      <span class="text-slate-500">Monitoring</span>
      <span class="text-slate-300">/</span>
      <span class="font-medium text-ink-900">Heute</span>
      <span
        class="ml-auto hidden h-6 w-56 items-center gap-1.5 rounded-md whitespace-nowrap bg-slate-100 px-2 text-slate-600 ring-1 ring-slate-200/70 @lg:flex"
      >
        <Search size={11} />
        Änderungen durchsuchen
        <span class="ml-auto font-mono text-[9px]">⌘K</span>
      </span>
      <span class="chip ml-auto bg-amber-50 text-amber-800 ring-1 ring-inset ring-amber-600/20 @lg:ml-0 @3xl:hidden"
        >Beispiel</span
      >
    </div>

    <div class="flex min-h-0 flex-1">
      <div class="flex min-w-0 flex-1 flex-col gap-3 p-3.5 @lg:p-4">
        <!-- Regionen-Status -->
        <div class="grid grid-cols-3 gap-2">
          {
            regions.map((r, i) => (
              <div class="rounded-lg border border-slate-200/90 bg-white p-2.5">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-[10px] font-semibold text-ink-900">{r.code}</span>
                  <span class="flex items-center gap-1 text-[9.5px] text-emerald-700">
                    <span class="size-1.5 rounded-full bg-emerald-500" />
                    <span class="hidden @md:inline">Überwacht</span>
                  </span>
                </div>
                <div class="mt-2 flex h-6 items-end gap-[2px]">
                  {activity[i]!.map((v, j) => (
                    <span
                      class:list={[
                        'flex-1 rounded-[1px]',
                        j === 11 ? 'bg-brand-600' : 'bg-brand-200',
                        ['h-[12%]', 'h-[25%]', 'h-[37%]', 'h-[50%]', 'h-[62%]', 'h-[75%]', 'h-[87%]', 'h-full', 'h-full'][v - 1],
                      ]}
                    />
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <!-- Änderungen -->
        <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-lg border border-slate-200/90">
          <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/60 px-3 py-2">
            <p class="font-semibold text-ink-900">Neue Änderungen</p>
            <span class="flex gap-1">
              <span class="chip bg-white text-ink-900 ring-1 ring-slate-200">Alle</span>
              <span class="chip hidden text-slate-500 @md:inline-flex">Kritisch</span>
              <span class="chip hidden text-slate-500 @md:inline-flex">Ungelesen</span>
            </span>
          </div>
          <ul class="divide-y divide-slate-100">
            {
              sampleUpdates.map((u, i) => (
                <li
                  class:list={[
                    'relative grid grid-cols-[auto_1fr_auto] items-center gap-x-2.5 gap-y-1 px-3 py-2.5 @md:grid-cols-[64px_34px_1fr_auto]',
                    i === 0 && 'bg-brand-50/50',
                  ]}
                >
                  {i === 0 && <span class="absolute inset-y-0 left-0 w-0.5 bg-brand-600" />}
                  <SeverityChip severity={u.severity} class="w-fit" />
                  <RegionChip region={u.region} class="hidden w-fit @md:inline-flex" />
                  <span class="min-w-0">
                    <span class="block truncate font-medium text-ink-900">{u.title}</span>
                    <span class="mt-0.5 block truncate text-[10px] text-slate-500">
                      <span class="@md:hidden">{u.region === 'US' ? 'USA' : u.region} · </span>
                      {u.source}
                    </span>
                  </span>
                  <span class="font-mono text-[10px] text-slate-500 tabular-nums">{u.time}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Detailbereich -->
      <aside class="hidden w-[248px] shrink-0 flex-col border-l border-slate-200/80 bg-slate-50/50 p-4 @4xl:flex">
        <div class="flex items-center gap-1.5">
          <SeverityChip severity={selected.severity} />
          <RegionChip region={selected.region} />
          <span class="ml-auto font-mono text-[9.5px] text-slate-500">{selected.time}</span>
        </div>
        <p class="mt-3 text-[13px] leading-snug font-semibold text-ink-900">{selected.title}</p>
        <p class="mt-1 text-[10px] text-slate-500">Quelle: {selected.source}</p>

        <div class="mt-4 rounded-lg border border-brand-100 bg-white p-3 shadow-card">
          <p class="flex items-center gap-1.5 font-semibold text-brand-700">
            <Sparkles size={12} stroke-width={2} /> KI-Zusammenfassung
          </p>
          <ul class="mt-2 space-y-1.5 text-[10.5px] leading-snug text-slate-700">
            <li class="flex gap-1.5"><span class="mt-[5px] size-1 shrink-0 rounded-full bg-brand-600"></span>Güterliste in Anhang I wird aktualisiert.</li>
            <li class="flex gap-1.5"><span class="mt-[5px] size-1 shrink-0 rounded-full bg-brand-600"></span>Einzelne Positionen werden neu gefasst.</li>
            <li class="flex gap-1.5"><span class="mt-[5px] size-1 shrink-0 rounded-full bg-brand-600"></span>Geltungsbeginn laut Veröffentlichung.</li>
          </ul>
        </div>

        <div class="mt-3 rounded-lg border border-slate-200/90 bg-white p-3">
          <p class="font-semibold text-ink-900">Mögliche Auswirkungen</p>
          <p class="mt-1 text-[10.5px] leading-snug text-slate-600">Klassifizierung betroffener Güter prüfen.</p>
        </div>

        <div class="mt-auto flex gap-1.5 pt-3">
          <span class="flex-1 rounded-md bg-ink-900 py-1.5 text-center text-[10px] font-medium text-white">Originalquelle</span>
          <span class="rounded-md border border-slate-200 bg-white px-2 py-1.5 text-[10px] text-slate-600">Gelesen</span>
        </div>
      </aside>
    </div>
  </div>
</div>
