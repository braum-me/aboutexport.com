---
// Konzept: Alert-Detail mit Dringlichkeit, Jurisdiktion, Regelwerk, Zeitpunkt und Quelle. Beispieldaten.
import { ArrowUpRight, Mail, Sparkles } from '@lucide/astro';
import RegionChip from './kit/RegionChip.astro';
import SeverityChip from './kit/SeverityChip.astro';
import { sampleUpdates, severityMeta } from './sample';

const queue = sampleUpdates.slice(0, 4);
---

<div class="@container relative flex size-full bg-ink-850 text-[11px] text-slate-400 select-none">
  <!-- Alert-Warteschlange -->
  <aside class="hidden w-[38%] shrink-0 flex-col border-r border-white/[0.07] @xl:flex">
    <div class="flex items-center justify-between border-b border-white/[0.07] px-4 py-3">
      <span class="font-semibold text-white">Alerts</span>
      <span class="chip bg-amber-400/10 text-amber-300 ring-1 ring-inset ring-amber-400/25">Beispieldaten</span>
    </div>
    <ul class="flex-1">
      {
        queue.map((a, i) => (
          <li
            class:list={[
              'relative border-b border-white/[0.05] px-4 py-3',
              i === 0 && 'bg-white/[0.04]',
            ]}
          >
            <span class:list={['absolute inset-y-2 left-0 w-[3px] rounded-r', severityMeta[a.severity].bar]} />
            <div class="flex items-center justify-between font-mono text-[9.5px]">
              <span class:list={[a.severity === 'critical' ? 'text-red-300' : a.severity === 'notice' ? 'text-amber-300' : 'text-slate-400']}>
                {severityMeta[a.severity].label} · {a.region === 'US' ? 'USA' : a.region}
              </span>
              <span class="text-slate-500">{a.time}</span>
            </div>
            <p class:list={['mt-1 leading-snug', i === 0 ? 'text-white' : 'text-slate-300']}>{a.title}</p>
          </li>
        ))
      }
    </ul>
  </aside>

  <!-- Alert-Detail -->
  <div class="flex min-w-0 flex-1 flex-col p-4 @lg:p-6">
    <div class="overflow-hidden rounded-xl bg-white text-slate-600 shadow-float">
      <div class="h-1 bg-gradient-to-r from-red-500 to-red-400"></div>
      <div class="p-4 @lg:p-5">
        <div class="flex flex-wrap items-center gap-1.5">
          <SeverityChip severity="critical" />
          <RegionChip region="EU" />
          <span class="chip bg-slate-100 text-slate-600">Dual-Use</span>
          <span class="ml-auto font-mono text-[10px] text-slate-500">Heute · 07:42</span>
        </div>
        <p class="mt-3 text-[14px] leading-snug font-semibold text-ink-900 @lg:text-[15px]">
          Aktualisierung von Anhang I der Dual-Use-Verordnung
        </p>
        <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-slate-100 pt-4">
          <div>
            <dt class="font-mono text-[9px] tracking-wider text-slate-500 uppercase">Jurisdiktion</dt>
            <dd class="mt-0.5 font-medium text-ink-900">Europäische Union</dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] tracking-wider text-slate-500 uppercase">Regelwerk</dt>
            <dd class="mt-0.5 font-medium text-ink-900">VO (EU) 2021/821 · Anhang I</dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] tracking-wider text-slate-500 uppercase">Quelle</dt>
            <dd class="mt-0.5 font-medium text-ink-900">Amtsblatt der EU</dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] tracking-wider text-slate-500 uppercase">Zugestellt</dt>
            <dd class="mt-0.5 font-medium text-ink-900">E-Mail · Dashboard</dd>
          </div>
        </dl>
        <p class="mt-4 flex gap-2 rounded-lg bg-brand-50/70 p-2.5 leading-snug text-slate-700 ring-1 ring-brand-100">
          <Sparkles size={12} class="mt-px shrink-0 text-brand-600" />
          Güterliste wird aktualisiert – Klassifizierung betroffener Güter prüfen.
        </p>
        <div class="mt-4 flex gap-2">
          <span class="rounded-md bg-brand-600 px-3 py-1.5 text-[10.5px] font-medium text-white">Zusammenfassung lesen</span>
          <span class="flex items-center gap-1 rounded-md border border-slate-200 px-3 py-1.5 text-[10.5px] font-medium text-ink-900">
            Originalquelle <ArrowUpRight size={11} />
          </span>
        </div>
      </div>
    </div>

    <div class="mt-auto hidden items-center gap-2.5 rounded-lg border border-white/10 bg-white/[0.05] p-2.5 @md:flex">
      <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-white/10 text-white"><Mail size={13} /></span>
      <span class="min-w-0">
        <span class="block truncate font-medium text-white">[Kritisch] EU · Anhang I der Dual-Use-Verordnung</span>
        <span class="block font-mono text-[9.5px] text-slate-500">AboutExport Alerts · an compliance@ihr-unternehmen.de</span>
      </span>
    </div>
  </div>
</div>
