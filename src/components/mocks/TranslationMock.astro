---
// Konzept: Original (Chinesisch) und deutsche Übersetzung nebeneinander. Beispieltext.
import { ArrowDown } from '@lucide/astro';
---

<div class="@container flex size-full flex-col gap-2 bg-slate-50 p-3 text-[11.5px] select-none @md:p-4">
  <div class="rounded-lg border border-slate-200 bg-white p-3">
    <p class="flex items-center gap-1.5 font-mono text-[9.5px] text-slate-500">
      <span class="chip bg-slate-100 text-slate-600">CN</span> Original · MOFCOM
    </p>
    <p class="mt-2 leading-relaxed text-slate-500" lang="zh">关于出口管制管控名单的公告</p>
  </div>
  <span class="flex justify-center text-brand-500"><ArrowDown size={14} /></span>
  <div class="rounded-lg border border-brand-200 bg-white p-3 ring-1 ring-brand-100">
    <p class="flex items-center gap-1.5 font-mono text-[9.5px] text-brand-700">
      <span class="chip bg-brand-600 text-white">DE</span> Automatische Übersetzung
    </p>
    <p class="mt-2 leading-relaxed font-medium text-ink-900">Bekanntmachung zur Kontrollliste der Exportkontrolle</p>
  </div>
</div>
