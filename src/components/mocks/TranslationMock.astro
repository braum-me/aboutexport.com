---
// Konzept: Original vs. deutsche Übersetzung
---

<div class="grid size-full grid-cols-2 gap-3 bg-slate-50 p-4 text-[12px] select-none sm:gap-4 sm:p-7">
  <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-3 sm:p-4">
    <p class="flex items-center gap-2 text-[11px] font-semibold text-slate-500">
      <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-600">CN</span> Original
    </p>
    <p class="mt-3 text-[13px] leading-relaxed text-slate-500" lang="zh">出口管制 · 公告</p>
    <div class="mt-3 space-y-1.5">
      {['w-full', 'w-11/12', 'w-full', 'w-3/4', 'w-5/6'].map((w) => <span class:list={['block h-2 rounded bg-slate-200', w]} />)}
    </div>
  </div>
  <div class="flex flex-col rounded-xl border border-brand-100 bg-white p-3 shadow-elevated sm:p-4">
    <p class="flex items-center gap-2 text-[11px] font-semibold text-brand-700">
      <span class="rounded bg-brand-50 px-1.5 py-0.5 text-[10px] text-brand-700">DE</span> Deutsche Übersetzung
    </p>
    <p class="mt-3 text-[13px] font-semibold leading-snug text-ink-900">Exportkontrolle · Bekanntmachung</p>
    <div class="mt-3 space-y-1.5">
      {['w-full', 'w-5/6', 'w-full', 'w-2/3', 'w-11/12'].map((w) => <span class:list={['block h-2 rounded bg-brand-100', w]} />)}
    </div>
  </div>
</div>
