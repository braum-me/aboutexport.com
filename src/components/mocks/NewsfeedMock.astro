---
// Konzept: täglicher Newsfeed, nach Relevanz sortiert. Beispieldaten.
import RegionChip from './kit/RegionChip.astro';
import { sampleUpdates } from './sample';

const items = [...sampleUpdates].sort((a, b) => {
  const order = { critical: 0, notice: 1, info: 2 } as const;
  return order[a.severity] - order[b.severity];
});
const relevance = { critical: 'Hoch', notice: 'Mittel', info: 'Niedrig' } as const;
const bars = { critical: 'w-full', notice: 'w-2/3', info: 'w-1/3' } as const;
---

<div class="@container flex size-full flex-col bg-white text-[11.5px] text-slate-600 select-none">
  <div class="flex items-end justify-between border-b border-slate-100 px-4 pt-4 pb-3 @lg:px-5">
    <div>
      <p class="font-mono text-[9.5px] tracking-wider text-brand-700 uppercase">Newsfeed · 06:00</p>
      <p class="mt-0.5 text-[14px] font-semibold text-ink-900">Ihre Compliance-News am Morgen</p>
    </div>
    <span class="chip bg-slate-100 text-slate-600">nach Relevanz</span>
  </div>
  <ul class="flex-1 divide-y divide-slate-100 px-4 @lg:px-5">
    {
      items.map((i) => (
        <li class="flex items-center gap-3 py-3">
          <div class="min-w-0 flex-1">
            <p class="truncate font-medium text-ink-900">{i.title}</p>
            <p class="mt-1 flex items-center gap-1.5 text-[10.5px] text-slate-500">
              <RegionChip region={i.region} />
              <span class="truncate">{i.topic} · {i.source}</span>
            </p>
          </div>
          <div class="hidden w-20 shrink-0 @md:block">
            <p class="text-right font-mono text-[9px] text-slate-500">{relevance[i.severity]}</p>
            <div class="mt-1 h-1 rounded-full bg-slate-100">
              <div class:list={['h-full rounded-full bg-brand-600', bars[i.severity]]} />
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</div>
