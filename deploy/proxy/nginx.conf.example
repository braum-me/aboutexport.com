# Nur verwenden, falls auf dem VPS bereits nginx läuft (siehe docs/deployment.md, Schritt 1).
# Zertifikat: Cloudflare Origin CA (SSL-Modus "Full (strict)") oder Let's Encrypt.
server {
    listen 80;
    listen [::]:80;
    server_name aboutexport.com www.aboutexport.com;
    return 301 https://aboutexport.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.aboutexport.com;
    ssl_certificate     /etc/ssl/aboutexport/origin.pem;
    ssl_certificate_key /etc/ssl/aboutexport/origin.key;
    return 301 https://aboutexport.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name aboutexport.com;
    ssl_certificate     /etc/ssl/aboutexport/origin.pem;
    ssl_certificate_key /etc/ssl/aboutexport/origin.key;

    client_max_body_size 64k;
    access_log /var/log/nginx/aboutexport.access.log; # Rotation per logrotate passend zu legal.logRetentionDays

    location / {
        proxy_pass http://127.0.0.1:4321;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;  # App: TRUST_PROXY_HOPS=2 (Cloudflare + nginx)
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        # br/gzip kommen vorkomprimiert aus der App – nginx reicht sie unverändert durch
    }
}
