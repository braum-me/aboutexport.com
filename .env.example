# --- SMTP (Pflicht für Kontakt- und Waitlist-Formular) ---------------------
# Ohne gültige Konfiguration melden die Formulare einen Fehler (HTTP 503),
# Anfragen werden nie stillschweigend verworfen.
SMTP_HOST=smtp.example.com
# 587 = STARTTLS (erzwungen), 465 = implizites TLS
SMTP_PORT=587
SMTP_USER=noreply@aboutexport.com
SMTP_PASSWORD=change-me
# Absender; muss vom SMTP-Server für SMTP_USER erlaubt sein (SPF/DKIM beachten)
SMTP_FROM="AboutExport Website <noreply@aboutexport.com>"
# Fester Empfänger aller Formular-Nachrichten
CONTACT_RECIPIENT=info@aboutexport.com
# Optional: TLS-Modus explizit setzen (sonst: Port 465 → true)
# SMTP_SECURE=false
# Nur für lokale Tests mit SMTP-Sink ohne TLS
# SMTP_REQUIRE_TLS=false

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=4321
# true NUR hinter einem Reverse Proxy, der X-Forwarded-For korrekt setzt
TRUST_PROXY=false

# --- Rate Limiting (pro IP und Formular) -------------------------------------
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
