# --- SMTP (Pflicht für Kontakt- und Waitlist-Formular) ---------------------
# Ohne gültige Konfiguration melden die Formulare einen Fehler (HTTP 503),
# Anfragen werden nie stillschweigend verworfen.
# Produktiv: Brevo SMTP-Relay (Domain aboutexport.com ist bei Brevo per SPF/DKIM authentifiziert).
# Login + SMTP-Schlüssel: Brevo → SMTP & API → SMTP. Niemals committen.
SMTP_HOST=smtp-relay.brevo.com
# 587 = STARTTLS (erzwungen), 465 = implizites TLS
SMTP_PORT=587
SMTP_USER=change-me@smtp-brevo.com
SMTP_PASSWORD=change-me
# Absender; muss vom SMTP-Server für SMTP_USER erlaubt sein (SPF/DKIM beachten)
SMTP_FROM="AboutExport Website <noreply@aboutexport.com>"
# Fester Empfänger aller Formular-Nachrichten
CONTACT_RECIPIENT=info@aboutexport.com
# Optional: TLS-Modus explizit setzen (sonst: Port 465 → true)
# SMTP_SECURE=false
# Nur für lokale Tests mit SMTP-Sink ohne TLS
# SMTP_REQUIRE_TLS=false

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=4321
# Host-Port für docker compose (gebunden an 127.0.0.1)
# HOST_PORT=4321
# true NUR hinter einem Reverse Proxy, der X-Forwarded-For korrekt setzt
TRUST_PROXY=false
# Anzahl vertrauenswürdiger Proxies, die X-Forwarded-For ergänzen
# (1 = nur lokaler Reverse Proxy, 2 = Cloudflare + lokaler Reverse Proxy)
TRUST_PROXY_HOPS=1
# Optional: Header mit der echten Client-IP vom vordersten Proxy, z. B. cf-connecting-ip.
# Nur setzen, wenn der Server ausschließlich über Cloudflare erreichbar ist (Firewall/Proxy beschränkt auf Cloudflare-IPs).
# CLIENT_IP_HEADER=cf-connecting-ip

# --- Rate Limiting (pro IP und Formular) -------------------------------------
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
